{
  "name": "scarpet-docgen",
  "type": "module",
  "version": "0.1.0",
  "description": "Generate markdown documentation from Scarpet scripts.",
  "main": "./lib/docgen.js",
  "bin": {
    "scarpet-docgen": "./bin/scarpet-docgen"
  },
  "scripts": {
    "lint": "tsc && eslint --fix \"lib/*.js\"",
    "format": "prettier --write \"lib/*.js\""
  },
  "keywords": [
    "scarpet",
    "minecraft",
    "documentation"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.16.0",
  "devDependencies": {
    "@types/node": "^20.11.5",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.4",
    "prettier-plugin-jsdoc": "^1.3.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "scarpet-parser": "github:fewwan/scarpet-parser"
  },
  "allowScripts": {
    "scarpet-parser@0.1.0": true,
    "github:fewwan/scarpet-parser#1e4dcd2c99a39a7a5035c5e85d100245fc6d6621": true
  }
}
